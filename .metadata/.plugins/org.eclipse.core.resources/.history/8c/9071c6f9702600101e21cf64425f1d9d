package Base;

import org.apache.logging.log4j.Logger;
import org.openqa.selenium.WebDriver;
import org.testng.annotations.*;

import Utils.Driver_Manager;
import Utils.Extent_Report;
import Utils.Logs;

public class Base_Class {

	public static WebDriver driver;
	private static Logger logger = Logs.getLogger(Base_Class.class);

	@BeforeSuite
	public void setup() {
		Extent_Report.initReport();  
		Driver_Manager.startdriver();
		driver = Driver_Manager.driver;
	}

	@AfterSuite
	public void teardown() {
		Driver_Manager.enddriver();
		Extent_Report.flushReport(); 
	}
}
